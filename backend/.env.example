# ---------------------------------------------------------------------
# KINEDOK ACADÉMIE — backend Django
# Copier en `.env` et renseigner. Ce fichier-ci ne contient aucun secret.
# ---------------------------------------------------------------------

# Généré par :  python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=remplacez-moi
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Algiers
LOG_LEVEL=INFO

# ----------------------------------------------------------- MySQL 8
DB_ENGINE=mysql
DB_NAME=kinedok_academie
DB_USER=kinedok
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# `DB_ENGINE=sqlite` permet de valider le schéma ou de lancer les tests
# sans serveur MySQL installé. Jamais en production.

# ------------------------------------------- Cookies, CSRF et CORS
# Origines du front-end (Vite en développement).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# En production, servir le front et l'API sur le même domaine et passer
# SESSION_COOKIE_SAMESITE=Lax. Sur deux domaines distincts, il faut
# SameSite=None et HTTPS des deux côtés.
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# --------------------------------------------------------- Courriel
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@kinedokdz.com
