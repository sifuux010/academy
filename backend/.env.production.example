# ---------------------------------------------------------------------
# KINEDOK ACADÉMIE — production : https://academy.kinedok.dz
#
# Copier en `.env` sur le serveur et renseigner les secrets. Ce fichier-ci
# n'en contient aucun.
#
# Le front et l'API sont servis par le MÊME domaine : le navigateur appelle
# `/api/...` en relatif. C'est ce qui permet de garder le cookie de session
# en `SameSite=Lax` — le réglage le plus sûr, et celui qui évite toute
# configuration CORS en écriture.
# ---------------------------------------------------------------------

# Généré par :  python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False

# Sans le port, et sans le schéma. Le `www.` n'est utile que si un
# enregistrement DNS existe pour lui.
DJANGO_ALLOWED_HOSTS=academy.kinedok.dz
DJANGO_TIME_ZONE=Africa/Algiers
LOG_LEVEL=WARNING

# ----------------------------------------------------------- MySQL 8
DB_ENGINE=mysql
DB_NAME=kinedok_academie
DB_USER=kinedok
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ------------------------------------------- Cookies, CSRF et CORS
#
# Avec le schéma, contrairement à ALLOWED_HOSTS : Django compare l'origine
# complète de l'en-tête `Origin`.
CSRF_TRUSTED_ORIGINS=https://academy.kinedok.dz
CORS_ALLOWED_ORIGINS=https://academy.kinedok.dz

# Même domaine des deux côtés : `Lax` suffit et protège des requêtes
# inter-sites. Ne passer à `None` que si l'API migre sur un autre domaine,
# et alors seulement avec HTTPS partout.
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Le reverse proxy (Nginx) termine TLS et transmet `X-Forwarded-Proto` :
# Django s'y fie pour savoir que la requête est bien arrivée en HTTPS.
SECURE_SSL_REDIRECT=True

# --------------------------------------------------------- Courriel
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=academie@kinedokdz.com
